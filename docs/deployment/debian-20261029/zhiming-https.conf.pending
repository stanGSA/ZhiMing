# Install as zhiming-domain.conf only after a trusted certificate is issued.
server {
    listen 80;
    listen [::]:80;
    server_name zhiming.mom;
    server_tokens off;
    location ^~ /.well-known/acme-challenge/ {
        root /var/lib/zhiming-acme;
        default_type text/plain;
        try_files $uri =404;
    }
    location / { return 308 https://zhiming.mom$request_uri; }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name zhiming.mom;
    server_tokens off;
    ssl_certificate /etc/letsencrypt/live/zhiming.mom/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/zhiming.mom/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:ZhiMingSSL:1m;
    ssl_session_timeout 1d;
    client_max_body_size 1m;
    access_log /var/log/nginx/zhiming-domain-access.log;
    error_log /var/log/nginx/zhiming-domain-error.log warn;
    location / {
        proxy_pass http://127.0.0.1:8765;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_connect_timeout 10s;
        proxy_read_timeout 420s;
        proxy_send_timeout 420s;
        proxy_buffering off;
        proxy_request_buffering off;
    }
}
