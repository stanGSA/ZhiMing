# /etc/zhiming/monitor.env — root:root 0600. Read only by zhiming-monitor.service.
# Fill at least one alert channel, then (as root; the monitor reads this file itself):
#   python3 -I /usr/local/lib/zhiming/monitor.py --test-alert

# Same value as ZHIMING_MONITOR_TOKEN in /etc/zhiming/runtime.env (install-ops.sh generates both).
ZHIMING_MONITOR_TOKEN=
ZHIMING_MONITOR_PUBLIC_URL=https://zhiming.mom
ZHIMING_MONITOR_LOCAL_URL=http://127.0.0.1:8765

# --- Alert channels (any combination) ---
# Webhook robot: wecom (企业微信) | dingtalk (钉钉) | feishu (飞书) | slack | generic (JSON)
ZHIMING_ALERT_WEBHOOK_KIND=wecom
ZHIMING_ALERT_WEBHOOK_URL=
# Signing secret for dingtalk / feishu robots with "加签" enabled; leave empty otherwise.
ZHIMING_ALERT_WEBHOOK_SECRET=
# Server酱 (WeChat push) SendKey
ZHIMING_ALERT_SERVERCHAN_KEY=
# E-mail: port 465 uses SSL, other ports STARTTLS (set ZHIMING_ALERT_SMTP_STARTTLS=0 to skip)
ZHIMING_ALERT_SMTP_HOST=
ZHIMING_ALERT_SMTP_PORT=465
ZHIMING_ALERT_SMTP_USER=
ZHIMING_ALERT_SMTP_PASSWORD=
ZHIMING_ALERT_SMTP_FROM=
ZHIMING_ALERT_SMTP_TO=

# Dead man's switch, e.g. a healthchecks.io ping URL: alerts you if the monitor itself stops.
ZHIMING_MONITOR_HEARTBEAT_URL=

# --- Thresholds (defaults shown) ---
#ZHIMING_MONITOR_REPEAT_HOURS=6
#ZHIMING_MONITOR_CERT_WARN_DAYS=21
#ZHIMING_MONITOR_CERT_CRIT_DAYS=7
#ZHIMING_MONITOR_DISK_PATHS=/,/opt/zhiming/data,/var/backups/zhiming
#ZHIMING_MONITOR_DISK_WARN_PCT=15
#ZHIMING_MONITOR_DISK_CRIT_PCT=8
#ZHIMING_MONITOR_DISK_WARN_GB=2
#ZHIMING_MONITOR_DISK_CRIT_GB=1
#ZHIMING_MONITOR_BACKUP_DIR=/var/backups/zhiming
#ZHIMING_MONITOR_BACKUP_MAX_AGE_H=26
#ZHIMING_MONITOR_ERROR_MIN_CALLS=5
#ZHIMING_MONITOR_ERROR_WARN=0.10
#ZHIMING_MONITOR_ERROR_CRIT=0.25
#ZHIMING_MONITOR_BUDGET_WARN_PCT=80
#ZHIMING_MONITOR_SPIKE_FACTOR=4
#ZHIMING_MONITOR_SPIKE_MIN_TOKENS=200000
#ZHIMING_MONITOR_RESTART_WARN=3
#ZHIMING_MONITOR_METRICS_FAILURES=2
#ZHIMING_MONITOR_SERVICES=zhiming,nginx
#ZHIMING_MONITOR_TIMERS=zhiming-backup.timer,zhiming-trace-retention.timer,certbot.timer
