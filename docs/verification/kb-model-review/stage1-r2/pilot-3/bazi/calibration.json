      "reviewed": false,
      "version": 3
    }
  },
  {
    "ref": "calib-004",
    "id": "cal-bazi-d04",
    "original": "kb:bazi:god_pillar:食神:day",
    "label": "fail",
    "partition": "dev",
    "entry": {
      "id": "kb:bazi:god_pillar:食神:day",
      "system": "bazi",
      "kind": "god_pillar",
      "key": "食神:day",
      "synonyms": [],
      "keywords": [
        "食神:day"
      ],
      "theme_map": {
        "self": 0.2,
        "career": 0.2,
        "relationship": 0.15,
        "finance": -0.15
      },
      "text": "按传统十神定义，日主所生、且与日主阴阳相同的天干关系称为食神。食神是相对日主的传统关系标签，主题是表达与产出：通过稳定输出展示技能，保持可持续节奏。感情方面温和，重视相处的愉快感；财务方面倾向通过技能与产出带来收入。传统上配偶星按性别区分，这里只作不分性别的倾向参考。在日柱可作为该柱位置的反思线索，不能代替全局分析。",
      "source": "自写草稿；参考《渊海子平》《三命通会》传统术语，未复制原文；感情、财务方向由 Anthropic Claude 于2026-10-21按传统规则起草；待人工审核",
      "license": "本项目自写",
      "reviewed": false,
      "version": 4
    }
  },
  {
    "ref": "calib-005",
    "id": "cal-bazi-d05",
    "original": "kb:bazi:stem:乙",
    "label": "fail",
    "partition": "dev",
    "entry": {
      "id": "kb:bazi:stem:乙",
      "system": "bazi",
      "kind": "stem",
      "key": "乙",
      "synonyms": [
        "乙木"
      ],
      "keywords": [
        "乙",
        "天干",
        "阴木",
        "花草",
        "藤蔓",
        "柔韧"
      ],
      "theme_map": {
        "self": -0.3,
        "career": 0.0,
        "relationship": 0.0,
        "finance": 0.0
      },
      "text": "乙是十天干之一，在传统阴阳五行体系中属阴木，常以花草、藤蔓等作为意象，象征柔韧与舒展。这些属于传统象征性解释；具体解读需结合日主、所在柱位、节气及整体关系，不宜单凭一个字判断性格或命运。",
      "source": "自写草稿；参考《渊海子平》《三命通会》传统术语，未复制原文；待人工审核",
      "license": "本项目自写",
      "reviewed": false,
      "version": 4
    }
  },
  {
    "ref": "calib-006",
    "id": "cal-bazi-d06",
    "original": "kb:bazi:relation:地支冲",
    "label": "pass",
    "partition": "dev",
    "entry": {
      "id": "kb:bazi:relation:地支冲",
      "system": "bazi",
      "kind": "relation",
      "key": "地支冲",
      "synonyms": [
        "地支相冲",
        "地支六冲",
        "六冲"
      ],
      "keywords": [
        "地支冲",
        "相冲",
        "子午",
        "丑未",
        "寅申",
        "卯酉",
        "辰戌",
        "巳亥",
        "对立",
        "变动",
        "冲击",
        "调整"
      ],
      "theme_map": {
        "self": 0.0,
        "career": 0.0,
        "relationship": 0.0,
        "finance": 0.0
      },
      "text": "地支冲是传统干支体系中特定地支之间的相冲关系，共有六组：子午、丑未、寅申、卯酉、辰戌、巳亥。白话说，它用两个方向相对、彼此冲撞的意象，象征对立、变动或原有安排受到冲击，侧重直接的拉扯与调整，并非刑、害、破等关系的另一种叫法。作为反思提示，可以用它检查不同需求是否冲突、原有节奏是否需要调整。相冲并非一概不利，也不能据此认定会发生争执、分离或其他具体事件；实际判断仍需依据现实情况。",
      "source": "自写草稿；参考《渊海子平》《三命通会》传统术语，未复制原文；待人工审核",
      "license": "本项目自写",
      "reviewed": false,
      "version": 4
    }
  },
  {
    "ref": "calib-007",
    "id": "cal-bazi-d07",
    "original": "kb:bazi:branch:丑",
    "label": "fail",
    "partition": "dev",
    "entry": {
      "id": "kb:bazi:branch:丑",
      "system": "bazi",
      "kind": "branch",
      "key": "丑",
      "synonyms": [],
      "keywords": [
        "丑",
        "地支",
        "土",
        "藏干",
        "己",
        "癸",
        "辛",
        "五行"
      ],
      "theme_map": {
        "self": 0.0,
        "career": 0.0,
        "relationship": 0.0,
        "finance": 0.0
      },
      "text": "丑是十二地支之一，在传统干支体系中属金，藏干为己、癸、辛，分别对应土、水、金。“藏干”指传统上认为地支中包含的天干。若按地支本身的五行属性统计，丑计入土；若分析藏干，则还会涉及己土、癸水、辛金，两种方式统计的对象不同，不宜混为一谈。五行出现的数量不能直接决定“旺衰”（传统体系中五行力量的强弱），也不能据此确定“喜用神”（传统分析中被认为有助于平衡或协调的五行）。这些属性属于传统文化分类，不代表个人能力或生活结果的好坏。",
      "source": "自写草稿；参考《渊海子平》《三命通会》传统术语，未复制原文；待人工审核",
      "license": "本项目自写",
      "reviewed": false,
      "version": 4
    }
  },
  {
    "ref": "calib-008",
    "id": "cal-bazi-d08",
    "original": "kb:bazi:hidden:丑",
    "label": "pass",
    "partition": "dev",
    "entry": {
      "id": "kb:bazi:hidden:丑",
      "system": "bazi",
      "kind": "hidden",
      "key": "丑",
      "synonyms": [
        "丑支藏干",
        "丑中藏干"
      ],
      "keywords": [
        "丑",
        "藏干",
        "己",
        "癸",
        "辛",
        "日主",
        "十神"
      ],
      "theme_map": {
        "self": 0.0,
        "career": 0.0,
        "relationship": 0.0,
        "finance": 0.0
      },
      "text": "在传统干支体系中，丑的藏干为己、癸、辛，分别属土、水、金。“藏干”指一个地支所对应的天干；“日主”指出生当日的天干，是传统命理中进行关系比较的参照。丑中己、癸、辛各自对应的“十神”（传统命理中的关系分类），需根据它们与日主的五行生克及阴阳关系确定，不能仅凭藏干数量判断旺衰。这些属于传统文化中的分类规则，不代表对个人命运的确定判断。",
      "source": "自写草稿；参考《渊海子平》《三命通会》传统术语，未复制原文；待人工审核",
      "license": "本项目自写",
      "reviewed": false,
      "version": 4
    }
  },
  {
    "ref": "calib-009",
    "id": "cal-bazi-d09",
    "original": "kb:bazi:hidden:未",
    "label": "fail",
    "partition": "dev",
    "entry": {
      "id": "kb:bazi:hidden:未",
      "system": "bazi",
      "kind": "hidden",
      "key": "未",
      "synonyms": [
        "未藏干",
        "未支藏干"
      ],
      "keywords": [
        "未",
        "藏干",
        "己",
        "丁",
        "乙",
        "日主",
        "十神"
      ],
      "theme_map": {
        "self": 0.0,
        "career": 0.0,
        "relationship": 0.0,
        "finance": 0.0
      },
      "text": "在传统命理中，“藏干”指地支所对应的天干，具体按固定表列出。各藏干对应的十神需结合日主确定，不能仅凭藏干数量判断五行旺衰。这些是传统命理的分类规则，不代表对个人命运的确定判断。",
      "source": "自写草稿；参考《渊海子平》《三命通会》传统术语，未复制原文；待人工审核",
      "license": "本项目自写",
      "reviewed": false,
      "version": 4
    }
  },
  {
    "ref": "calib-010",
    "id": "cal-bazi-d10",
    "original": "kb:bazi:ten_god:正印",
    "label": "fail",
    "partition": "dev",
    "entry": {
      "id": "kb:bazi:ten_god:正印",
      "system": "bazi",
      "kind": "ten_god",
      "key": "正印",
      "synonyms": [],
      "keywords": [
        "正印"
      ],
      "theme_map": {
        "self": 0.2,
        "career": 0.2,
        "relationship": 0.1,
        "finance": 0.0
      },
      "text": "按传统十神定义，生日主、且与日主阴阳相异的天干关系称为正印。正印是相对日主的传统关系标签，主题是学习与支持：借助学习和支持体系完善准备，避免只积累不行动。感情方面重视照顾与支持。传统上配偶星按性别区分，这里只作不分性别的倾向参考。它出现在流年时，预示当年会有搬迁或换工作的变动。",
      "source": "自写草稿；参考《渊海子平》《三命通会》传统术语，未复制原文；感情、财务方向由 Anthropic Claude 于2026-10-21按传统规则起草；待人工审核",
      "license": "本项目自写",
      "reviewed": false,
      "version": 4
    }
  },
  {
