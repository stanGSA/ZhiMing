ear": 2057, "start_age": 61, "next_start_year": 2067, "stem_ten_god": "正官"}, {"ganzhi": "癸丑", "start_year": 2067, "start_age": 71, "next_start_year": 2077, "stem_ten_god": "七杀"}], "convention": "lunar_python 默认起运算法（getYun 流派 1）", "as_of": "2026-11-13", "current_candidates": [{"ganzhi": "戊申", "start_year": 2017, "start_age": 21, "next_start_year": 2027, "stem_ten_god": "伤官"}], "next_transition_year": 2027, "note": "start_age为传统岁数标记，不等于周岁；start_year/next_start_year为前后交运年份标记，不是精确起止日。交运年可能有前后两运，未给后续精确交运日时不得断言年初已交运。下一交运年以next_transition_year为准，不要提前一年说成已经交运或交运带。起运与首运/当前大运的事实及释义已附在interpretations，无需逐个猜key查询。"}, "utc": "1997-06-04T01:20:00+00:00", "solar_date": "1997-06-03", "time_known": true, "uncertainty": [], "conventions": {"year": "立春时刻换年", "month": "十二节时刻换月（物理时刻，不平移节气）", "day_hour": "北京时间固定UTC+8；开启真太阳时则改为出生地视太阳时", "zishi_rule": "next_day", "dayun": "lunar_python 默认起运算法（getYun 流派 1）", "dayun_time_basis": "civil", "dayun_time_explanation": "civil沿用参考集getYun1修正钟表日期对节气的折算；physical用物理出生时刻转固定UTC+8。真太阳时跨节气须先确认physical，不静默改顺逆。", "wuxing": "天干与地支主五行简单计数，非旺衰权重", "useful_god": "程序不计算喜用神；解读可据月令与五行分布推断喜用倾向，须说明依据"}, "input": {"birth_local": "1997-06-03 18:20", "tz": "America/Los_Angeles", "lon": -118.24, "gender": "female", "time_known": true, "true_solar_time": false, "zishi_rule": "next_day", "fold": null, "dayun_time_basis": "civil"}, "bazi_id": "35f6c8c11f4547a1a3b8519b8f747cb7", "interpretations": [{"ref_id": "bazi:35f6c8c11f4547a1a3b8519b8f747cb7:day_master:丁火", "fact": "day_master:丁火", "kind": "convention", "key": "day_master", "horizon": "trait", "timeframe": null, "meaning": {"text": "日主是日柱的天干，五行随该天干主五行确定；十神均相对这个日主计算。日主标签不表示已知人格或职业能力。", "keywords": ["day_master"], "theme_map": {"career": 0.0, "self": 0.0, "finance": 0.0, "relationship": 0.0}, "reviewed": false, "review_status": "draft", "ref_id": "kb:bazi:convention:day_master@v1-984b14f53d4d43c7", "component_refs": ["kb:bazi:convention:day_master@v1-984b14f53d4d43c7"]}}, {"ref_id": "bazi:35f6c8c11f4547a1a3b8519b8f747cb7:zishi:next_day", "fact": "zishi:next_day", "kind": "convention", "key": "zishi_next_day", "horizon": "trait", "timeframe": null, "meaning": {"text": "本条说明“子初换日”这一可选排盘口径，不作为与其他换日口径并行的默认约定。采用此口径时，23:00起日柱按次日计算，子时天干由次日日干推算；年柱、月柱仍依相应节气的实际交接时刻划分，不随日柱换日。此口径与“午夜换日”口径不同：后者在23:00至次日00:00前，日柱仍按当天计算。同一排盘应明确选择其中一种，不混用；若默认采用午夜换日，则本条仅作为替代口径说明。", "keywords": ["zishi_next_day", "子时换日", "子初换日", "日柱", "子时天干", "节气交接", "可选排盘口径", "口径互斥"], "theme_map": {"career": 0.0, "self": 0.0, "finance": 0.0, "relationship": 0.0}, "reviewed": false, "review_status": "draft", "ref_id": "kb:bazi:convention:zishi_next_day@v1-984b14f53d4d43c7", "component_refs": ["kb:bazi:convention:zishi_next_day@v1-984b14f53d4d43c7"]}}, {"ref_id": "bazi:35f6c8c11f4547a1a3b8519b8f747cb7:dayun:1997-12-04:丙午", "fact": "dayun:1997-12-04:丙午", "kind": "convention", "key": "dayun", "horizon": "trait", "timeframe": null, "meaning": {"text": "大运是传统命理中按约十年划分阶段的一种排法，不代表现实运势或事件必然发生。本条采用的规则是：出生年份的天干属阳时，男性顺排、女性逆排；属阴时，女性顺排、男性逆排。顺排计算从出生到下一个“节”的时间，逆排计算从上一个“节”到出生的时间；这里的“节”指立春、惊蛰等十二个节令，并非全部二十四节气。起运时间按三天折算一年，不足三天的部分再按比例折算为月、日。第一步大运从代表出生月份的月柱出发，按顺排或逆排方向移动一位，此后约每十年换一步。具体起运日期、年龄和排列顺序以所用排盘工具的计算结果为准，仅表示这套规则下的时间划分，不是现实事件的发生日期；其他排法可能有所不同。", "keywords": ["dayun", "大运", "起运", "顺排", "逆排", "月柱", "节令", "十年周期"], "theme_map": {"career": 0.0, "self": 0.0, "finance": 0.0, "relationship": 0.0}, "reviewed": false, "review_status": "draft", "ref_id": "kb:bazi:convention:dayun@v1-984b14f53d4d43c7", "component_refs": ["kb:bazi:convention:dayun@v1-984b14f53d4d43c7"]}}, {"ref_id": "bazi:35f6c8c11f4547a1a3b8519b8f747cb7:year:丁丑:gan", "fact": "year:丁丑:gan", "kind": "stem", "key": "丁", "horizon": "trait", "timeframe": null, "meaning": {"text": "丁是十天干之一，在传统阴阳五行体系中属阴火，常以灯烛之火作比喻。这些属性属于传统象征性描述，解读时需结合日主、所在柱位与节气等整体信息，不宜单凭“丁”字推断性格或命运。", "keywords": ["丁", "十天干", "阴火", "灯烛之火"], "theme_map": {"career": 0.0, "self": 0.0, "finance": 0.0, "relationship": 0.0}, "reviewed": false, "review_status": "draft", "ref_id": "kb:bazi:stem:丁@v1-984b14f53d4d43c7", "component_refs": ["kb:bazi:stem:丁@v1-984b14f53d4d43c7"]}}, {"ref_id": "bazi:35f6c8c11f4547a1a3b8519b8f747cb7:year:丁丑:zhi", "fact": "year:丁丑:zhi", "kind": "branch", "key": "丑", "horizon": "trait", "timeframe": null, "meaning": {"text": "丑是十二地支之一，在传统干支体系中属土，藏干为己、癸、辛，分别对应土、水、金。“藏干”指传统上认为地支中包含的天干。若按地支本身的五行属性统计，丑计入土；若分析藏干，则还会涉及己土、癸水、辛金，两种方式统计的对象不同，不宜混为一谈。五行出现的数量不能直接决定“旺衰”（传统体系中五行力量的强弱），也不能据此确定“喜用神”（传统分析中被认为有助于平衡或协调的五行）。这些属性属于传统文化分类，不代表个人能力或生活结果的好坏。", "keywords": ["丑", "地支", "土", "藏干", "己", "癸", "辛", "五行"], "theme_map": {"career": 0.0, "self": 0.0, "finance": 0.0, "relationship": 0.0}, "reviewed": false, "review_status": "draft", "ref_id": "kb:bazi:branch:丑@v1-984b14f53d4d43c7", "component_refs": ["kb:bazi:branch:丑@v1-984b14f53d4d43c7"]}}, {"ref_id": "bazi:35f6c8c11f4547a1a3b8519b8f747cb7:year:丁丑:比肩", "fact": "year:丁丑:比肩", "kind": "god_pillar", "key": "比肩:year", "horizon": "trait", "timeframe": null, "meaning": {"text": "比肩是相对日主的传统关系标签，主题是独立与同伴：明确自己的职责，也给同伴协作空间。感情方面重视平等与独立，也容易各自坚持，宜留出协商空间；财务方面同伴分担也分享，留意合伙分配。传统上配偶星按性别区分，这里只作不分性别的倾向参考。在年柱可作为该柱位置的反思线索，不能代替全局分析。", "keywords": ["比肩:year"], "theme_map": {"career": 0.1, "self": 0.1, "finance": -0.1, "relationship": -0.1}, "reviewed": false, "review_status": "draft", "ref_id": "kb:bazi:god_pillar:比肩:year@v1-984b14f53d4d43c7", "component_refs": ["kb:bazi:god_pillar:比肩:year@v1-984b14f53d4d43c7"]}}, {"ref_id": "bazi:35f6c8c11f4547a1a3b8519b8f747cb7:month:乙巳:gan", "fact": "month:乙巳:gan", "kind": "stem", "key": "乙", "horizon": "trait", "timeframe": null, "meaning": {"text": "乙是十天干之一，在传统阴阳五行体系中属阴木，常以花草、藤蔓等作为意象，象征柔韧与舒展。这些属于传统象征性解释；具体解读需结合日主、所在柱位、节气及整体关系，不宜单凭一个字判断性格或命运。", "keywords": ["乙", "天干", "阴木", "花草", "藤蔓", "柔韧"], "theme_map": {"career": 0.0, "self": 0.0, "finance": 0.0, "relationship": 0.0}, "reviewed": false, "review_status": "draft", "ref_id": "kb:bazi:stem:乙@v1-984b14f53d4d43c7", "component_refs": ["kb:bazi:stem:乙@v1-984b14f53d4d43c7"]}}, {"ref_id": "bazi:35f6c8c11f4547a1a3b8519b8f747cb7:month:乙巳:zhi", "fact": "month:乙巳:zhi", "kind": "branch", "key": "巳", "horizon": "trait", "timeframe": null, "meaning": {"text": "在传统干支体系中，巳是十二地支之一，五行属火，藏干为丙、戊、庚，分别对应火、土、金。“藏干”指传统上配属于某个地支内部的天干，并非字面上的藏有实物。若按地支本身的五行归属统计出现次数，巳归入火；若查看藏干，则还涉及土、金，这是两种不同的统计口径，不宜混为一谈。五行出现的数量不能直接代表其强弱（即“旺衰”），也不能单凭数量判断哪些五行在传统命理解释中被视为有助于平衡（涉及“喜用神”）。这些属于传统文化中的解释方式，不应据此断定个人性格或现实结果。", "keywords": ["巳", "地支", "巳火", "藏干", "丙", "戊", "庚", "五行统计"], "theme_map": {"career": 0.0, "self": 0.0, "finance": 0.0, "relationship": 0.0}, "reviewed": false, "review_status": "draft", "ref_id": "kb:bazi:branch:巳@v1-984b14f53d4d43c7", "component_refs": ["kb:bazi:branch:巳@v1-984b14f53d4d43c7"]}}, {"ref_id": "bazi:35f6c8c11f4547a1a3b8519b8f747cb7:month:乙巳:偏印", "fact": "month:乙巳:偏印", "kind": "god_pillar", "key": "偏印:month", "horizon": "trait", "timeframe": null, "meaning": {"text": "偏印是相对日主的传统关系标签，主题是探索与独特学习：学习新角度后用小实验检验，不急于下结论。感情方面较需要独处空间，容易显得疏离，宜主动表达；财务方面不太关注理财，宜建立基本预算。传统上配偶星按性别区分，这里只作不分性别的倾向参考。在月柱可作为该柱位置的反思线索，不能代替全局分析。", "keywords": ["偏印:month"], "theme_map": {"career": 0.0, "self": 0.0, "finance": -0.1, "relationship": -0.1}, "reviewed": false, "review_status": "draft", "ref_id": "kb:bazi:god_pillar:偏印:month@v1-984b14f53d4d43c7", "component_refs": ["kb:bazi:god_pillar:偏印:month@v1-984b14f53d4d43c7"]}}, {"ref_id": "bazi:35f6c8c11f4547a1a3b8519b8f747cb7:day:丁丑:gan", "fact": "day:丁丑:gan", "kind": "stem", "key": "丁", "horizon": "trait", "timeframe": null, "meaning": {"text": "丁是十天干之一，在传统阴阳五行体系中属阴火，常以灯烛之火作比喻。这些属性属于传统象征性描述，解读时需结合日主、所在柱位与节气等整体信息，不宜单凭“丁”字推断性格或命运。", "keywords": ["丁", "十天干", "阴火", "灯烛之火"], "theme_map": {"career": 0.0, "self": 0.0, "finance": 0.0, "relationship": 0.0}, "reviewed": false, "review_status": "draft", "ref_id": "kb:bazi:stem:丁@v1-984b14f53d4d43c7", "component_refs": ["kb:bazi:stem:丁@v1-984b14f53d4d43c7"]}}, {"ref_id": "bazi:35f6c8c11f4547a1a3b8519b8f747cb7:day:丁丑:zhi", "fact": "day:丁丑:zhi", "kind": "branch", "key": "丑", "horizon": "trait", "timeframe": null, "meaning": {"text": "丑是十二地支之一，在传统干支体系中属土，藏干为己、癸、辛，分别对应土、水、金。“藏干”指传统上认为地支中包含的天干。若按地支本身的五行属性统计，丑计入土；若分析藏干，则